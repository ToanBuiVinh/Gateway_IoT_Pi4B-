# Mẫu biến môi trường chứa BÍ MẬT cho gateway.
# Copy thành .env (đã .gitignore) rồi điền giá trị thật:  cp .env.example .env
#
# Cách nạp khi chạy thủ công:   set -a; . ./.env; set +a; python -m src.main
# Với systemd: đặt file này ở /etc/iot-gateway/secrets.env và dùng EnvironmentFile.

# --- Broker cục bộ (Mosquitto trên Pi) ---
LOCAL_MQTT_USER=gateway
LOCAL_MQTT_PASS=doi_mat_khau_nay

# --- Cloud MQTT broker ---
CLOUD_MQTT_USER=cloud_user
CLOUD_MQTT_PASS=doi_mat_khau_nay
