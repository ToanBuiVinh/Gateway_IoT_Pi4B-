{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinic001.example.vn/schema/canonical-v2.json",
  "title": "Canonical MQTT Envelope v2.1",
  "description": "Mo rong v2.0 (5 thiet bi numeric) -> v2.1: them message_type waveform/imaging/media va truong sampled_data, media. Tuong thich nguoc: payload v2.0 van hop le.",
  "type": "object",
  "required": ["schema_version", "message_id", "message_type", "clinic_id", "gateway_id", "timestamps", "device", "patient", "measurements"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "enum": ["2.0", "2.1"] },
    "message_id": { "type": "string", "format": "uuid" },
    "message_type": {
      "type": "string",
      "enum": [
        "observation.vitals", "observation.lab", "observation.waveform",
        "imaging.study", "media.audio", "media.video",
        "device.status", "alert.clinical", "ack"
      ]
    },
    "clinic_id": { "type": "string" },
    "gateway_id": { "type": "string" },
    "sequence_no": { "type": "integer", "minimum": 0 },
    "timestamps": {
      "type": "object",
      "required": ["measured_at", "received_at", "sent_at", "clock_source"],
      "additionalProperties": false,
      "properties": {
        "measured_at": { "type": "string", "format": "date-time" },
        "received_at": { "type": "string", "format": "date-time" },
        "sent_at": { "type": "string", "format": "date-time" },
        "clock_source": { "type": "string", "enum": ["ntp", "device", "gateway"] }
      }
    },
    "device": {
      "type": "object",
      "required": ["device_id", "device_type", "connection", "device_class"],
      "additionalProperties": false,
      "properties": {
        "device_id": { "type": "string" },
        "device_type": { "type": "string" },
        "serial_number": { "type": "string" },
        "firmware_version": { "type": "string" },
        "connection": { "type": "string", "enum": ["ble", "wifi", "usb", "lan"] },
        "mac_address": { "type": "string" },
        "device_class": { "type": "string", "enum": ["commercial", "investigational"] }
      }
    },
    "patient": {
      "type": "object",
      "required": ["patient_id"],
      "additionalProperties": false,
      "properties": {
        "patient_id": { "type": "string" },
        "encounter_id": { "type": "string" }
      }
    },
    "patient_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "enum": ["qr_scan", "ui_select", "station"] },
        "operator_id": { "type": "string" },
        "bound_at": { "type": "string", "format": "date-time" }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "status"],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "object",
            "required": ["system", "code"],
            "properties": {
              "system": { "type": "string" },
              "code": { "type": "string" },
              "display": { "type": "string" }
            }
          },
          "value": { "type": ["number", "null"] },
          "unit": { "type": "string" },
          "status": { "type": "string", "enum": ["final", "preliminary", "entered-in-error"] },
          "components": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "required": ["code", "value", "unit"],
              "properties": {
                "code": { "type": "object" },
                "value": { "type": "number" },
                "unit": { "type": "string" }
              }
            }
          },
          "body_site": { "type": ["string", "null"] },
          "method": { "type": ["string", "null"] },
          "quality": {
            "type": ["object", "null"],
            "properties": {
              "signal_quality": { "type": ["string", "null"] },
              "confidence": { "type": ["number", "null"] }
            }
          },
          "device_flags": { "type": "object" },
          "sampled_data": {
            "type": ["object", "null"],
            "required": ["unit", "period_ms", "data"],
            "properties": {
              "lead": { "type": "string" },
              "origin_value": { "type": "number" },
              "unit": { "type": "string" },
              "period_ms": { "type": "number", "exclusiveMinimum": 0 },
              "frequency_hz": { "type": "number" },
              "factor": { "type": "number" },
              "dimensions": { "type": "integer", "minimum": 1 },
              "sample_count": { "type": "integer", "minimum": 0 },
              "data": { "type": "string", "description": "Chuoi mau cach nhau bang space (FHIR SampledData.data). Co the da rut gon trong file mau." },
              "truncated": { "type": "boolean" }
            }
          },
          "raster": {
            "type": ["object", "null"],
            "description": "Du lieu diem anh THO (vd sieu am gray8). Phia hien thi tai tao thanh hinh anh.",
            "required": ["pixel_format", "width", "height", "encoding", "data"],
            "properties": {
              "pixel_format": { "type": "string", "enum": ["gray8"] },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "encoding": { "type": "string", "enum": ["base64", "csv"] },
              "data": { "type": "string" },
              "geometry": { "type": "string", "enum": ["sector", "linear", "rect"] },
              "depth_cm": { "type": "number" },
              "frame_index": { "type": "integer", "minimum": 0 },
              "frame_count": { "type": "integer", "minimum": 1 }
            }
          },
          "media": {
            "type": ["object", "null"],
            "required": ["content_type", "url"],
            "properties": {
              "content_type": { "type": "string" },
              "modality": { "type": "string" },
              "url": { "type": "string" },
              "size_bytes": { "type": "integer", "minimum": 0 },
              "duration_sec": { "type": "number" },
              "width": { "type": "integer" },
              "height": { "type": "integer" },
              "frames": { "type": "integer" },
              "number_of_series": { "type": "integer" },
              "number_of_instances": { "type": "integer" },
              "sha256": { "type": "string" },
              "body_site": { "type": "string" }
            }
          }
        },
        "allOf": [
          {
            "comment": "Khi value la so -> bat buoc co unit (do numeric). Media/waveform khong can unit o cap item.",
            "if": { "properties": { "value": { "type": "number" } }, "required": ["value"] },
            "then": { "required": ["unit"] }
          }
        ]
      }
    }
  }
}
